      <aliases enabled='yes' />
      <column caption='Has Education Data' datatype='boolean' name='[Calculation_2198038149958082560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([% of GDP Spent On Education]) OR&#13;&#10;NOT ISNULL([Adult Literacy Rate %]) OR&#13;&#10;NOT ISNULL([Primary School Completion Rate %]) OR&#13;&#10;NOT ISNULL([Primary Pupil-Teacher Ratio]) OR&#13;&#10;NOT ISNULL([Secondary Pupil-Teacher Ratio]) OR&#13;&#10;NOT ISNULL([Primary School Enrollment %]) OR&#13;&#10;NOT ISNULL([Secondary School Enrollment %]) OR&#13;&#10;NOT ISNULL([Tertiary School Enrollment %])' />
      </column>
      <column caption='Wealth + GINI' datatype='boolean' name='[Calculation_2198038149958234113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([Wealth Index]) AND&#13;&#10;NOT ISNULL([GINI Index])' />
      </column>
      <column caption='Wealth + Education' datatype='boolean' name='[Calculation_2198038149958385666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([Wealth Index]) AND&#13;&#10;[Calculation_2198038149958082560]' />
      </column>
      <column caption='GINI + Education' datatype='boolean' name='[Calculation_2198038149958467587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([GINI Index]) AND&#13;&#10;[Calculation_2198038149958082560]' />
      </column>
      <column caption='Wealth + GINI + Education' datatype='boolean' name='[Calculation_2198038149958537220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([Wealth Index]) AND&#13;&#10;NOT ISNULL([GINI Index]) AND&#13;&#10;[Calculation_2198038149958082560]' />
      </column>
